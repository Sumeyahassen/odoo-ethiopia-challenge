<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data noupdate="1">
        <record id="seq_ethio_delivery_order" model="ir.sequence">
            <field name="name">Ethio Delivery Order</field>
            <field name="code">ethio.delivery.order</field>
            <field name="prefix">DO/%(year)s/</field>
            <field name="padding">5</field>
            <field name="company_id" eval="False"/>
        </record>

        <record id="seq_ethio_route" model="ir.sequence">
            <field name="name">Ethio Route</field>
            <field name="code">ethio.route</field>
            <field name="prefix">RT/%(year)s/</field>
            <field name="padding">4</field>
            <field name="company_id" eval="False"/>
        </record>
    </data>
</odoo>