<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_vault_credential_list" model="ir.ui.view">
        <field name="name">vault.credential.list</field>
        <field name="model">vault.credential</field>
        <field name="arch" type="xml">
            <list string="Credentials">
                <field name="name" string="Credential Title"/>
                <field name="project_id" string="Project"/>
                <field name="environment" widget="badge"
                       decoration-danger="environment == 'production'"
                       decoration-warning="environment == 'staging'"
                       decoration-info="environment == 'development'"
                       decoration-muted="environment == 'local'"/>
                <field name="username"/>
                <field name="password"/>
                <field name="url" widget="url"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vault_credential_form" model="ir.ui.view">
        <field name="name">vault.credential.form</field>
        <field name="model">vault.credential</field>
        <field name="arch" type="xml">
            <form string="Credential">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Credential Title"/>
                        <h1>
                            <field name="name" placeholder="e.g. Production Admin / Postgres Root"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Project &amp; Environment">
                            <field name="project_id" placeholder="Select project..."/>
                            <field name="environment"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                        <group string="Authentication Details">
                            <field name="username" placeholder="admin or email@example.com"/>
                            <label for="password" string="Password / Secret"/>
                            <div class="o_row">
                                <field name="password" password="True" invisible="show_password" placeholder="••••••••"/>
                                <field name="password" invisible="not show_password" placeholder="Enter password"/>
                                <span class="d-flex align-items-center gap-1 ms-2">
                                    <field name="show_password" widget="boolean_toggle" nolabel="1"/>
                                    <span class="text-muted small" invisible="not show_password">Visible</span>
                                    <span class="text-muted small" invisible="show_password">Masked</span>
                                </span>
                            </div>
                            <field name="url" widget="url" placeholder="https://portal.example.com/login"/>
                        </group>
                    </group>
                    <group string="Notes &amp; Setup Instructions">
                        <field name="notes" placeholder="Add IP whitelist rules, server ports, or recovery steps..." nolabel="1"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_vault_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">vault.credential</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Store a new credential
            </p>
            <p>
                Securely record logins, database access, and API tokens categorized by project and environment.
            </p>
        </field>
    </record>
</odoo>
