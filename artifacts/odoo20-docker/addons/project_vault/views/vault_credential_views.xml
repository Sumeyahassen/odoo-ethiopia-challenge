<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_vault_credential_list" model="ir.ui.view">
        <field name="name">vault.credential.list</field>
        <field name="model">vault.credential</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="project_id"/>
                <field name="environment"/>
                <field name="username"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_vault_credential_form" model="ir.ui.view">
        <field name="name">vault.credential.form</field>
        <field name="model">vault.credential</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="project_id"/>
                        <field name="environment"/>
                        <field name="username"/>
                        <field name="password" password="True"/>
                        <field name="url"/>
                        <field name="notes"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_vault_credential" model="ir.actions.act_window">
        <field name="name">Credentials</field>
        <field name="res_model">vault.credential</field>
        <field name="view_mode">list,form</field>
    </record>
</odoo>