<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <!-- List / Tree View -->
    <record id="view_vault_technology_list" model="ir.ui.view">
        <field name="name">vault.technology.list</field>
        <field name="model">vault.technology</field>
        <field name="arch" type="xml">
            <list string="Technologies">
                <field name="name" string="Technology Name"/>
                <field name="category" widget="badge"/>
                <field name="active" widget="boolean_toggle"/>
            </list>
        </field>
    </record>

    <!-- Form View -->
    <record id="view_vault_technology_form" model="ir.ui.view">
        <field name="name">vault.technology.form</field>
        <field name="model">vault.technology</field>
        <field name="arch" type="xml">
            <form string="Technology">
                <sheet>
                    <div class="oe_title">
                        <label for="name" string="Technology Name"/>
                        <h1>
                            <field name="name" placeholder="e.g. React, PostgreSQL, Docker"/>
                        </h1>
                    </div>
                    <group>
                        <group string="Configuration">
                            <field name="category"/>
                            <field name="color"/>
                            <field name="active" widget="boolean_toggle"/>
                        </group>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <!-- Window Action -->
    <record id="action_vault_technology" model="ir.actions.act_window">
        <field name="name">Technologies</field>
        <field name="res_model">vault.technology</field>
        <field name="view_mode">list,form</field>
        <field name="help" type="html">
            <p class="o_view_nocontent_smiling_face">
                Add a new technology
            </p>
            <p>
                Define tools, frameworks, and databases used across your projects.
            </p>
        </field>
    </record>
</odoo>
